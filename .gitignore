# Allowlist: everything is ignored unless listed below, so private material (recordings, game frames, analysis
# archives, settings files) cannot be committed by accident. A new top-level entry is added here on purpose, and to
# allowedPaths in publish-policy.json (two locks, checked by scripts/privacy-scan.mjs).
/*
!/.githooks/
!/.github/
!/build/
!/desktop/
!/docs/
!/scripts/
!/src/
!/tests/
!/tools/
!/CHANGELOG.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.npmrc
!/.nvmrc
!/.prettierignore
!/.prettierrc.json
!/electron-builder.yml
!/eslint.config.mjs
!/package-lock.json
!/package.json
!/playwright.config.mjs
!/playwright.perf.config.mjs
!/privacy-worklist.json
!/publish-policy.json

# Never, even inside allowed folders.
.publish-denylist
node_modules/
dist/
release/
test-results/
playwright-report/
blob-report/
tests/output/
*.log
*.log.json
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# Media, archives, executables and game data (tests/fixtures/recordings/*.gz is allowed by sha256 in publish-policy.json).
*.mkv
*.mp4
*.mov
*.avi
*.webm
*.wav
*.mp3
*.ogg
*.flac
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.zip
*.7z
*.rar
*.zst
*.pak
*.uasset
*.umap
*.npy
*.npz
*.ini
*.exe
*.dll
*.msi
*.lnk
*.ps1
*.bat
*.cmd
