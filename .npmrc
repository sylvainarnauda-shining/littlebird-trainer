# Supply-chain defaults. No dependency lifecycle script runs on install: none of ours needs one (@napi-rs/canvas ships
# prebuilt platform packages; the Playwright browser is installed explicitly in CI, and locally the installed Chrome is
# used). Exact versions in package.json; package-lock.json is authoritative and CI uses `npm ci`.
ignore-scripts=true
save-exact=true
engine-strict=true
fund=false
