root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# The imported runtime and the golden recorder keep their bytes (goldens and G0 pin them).
[{src/**,tools/golden/**,tests/fixtures/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
