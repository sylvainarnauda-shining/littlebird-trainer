{
  "name": "littlebird-trainer",
  "productName": "LittleBird Trainer",
  "version": "0.9.0",
  "private": true,
  "description": "Entraîneur hors ligne de pilotage et de tir pour hélicoptère léger (WebGL).",
  "license": "MIT",
  "author": {
    "name": "sylvainarnauda-shining and contributors",
    "url": "https://github.com/sylvainarnauda-shining"
  },
  "homepage": "https://github.com/sylvainarnauda-shining/littlebird-trainer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylvainarnauda-shining/littlebird-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/sylvainarnauda-shining/littlebird-trainer/issues"
  },
  "type": "commonjs",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && npm run icon && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && npm run icon && electron-builder --win --x64 --dir --publish never",
    "desktop:check": "node scripts/check-fuses.mjs release/win-unpacked/LittleBirdTrainer.exe && node scripts/check-asar.mjs release/win-unpacked/resources/app.asar dist/web/index.html && node scripts/check-electron-runtime.mjs release/win-unpacked && node scripts/desktop-smoke.mjs release/win-unpacked/LittleBirdTrainer.exe",
    "release:check": "node scripts/release-check.mjs release",
    "test": "node --test \"tests/{unit,fidelity,regression,integration,build,security,desktop}/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:fidelity": "node --test \"tests/fidelity/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:golden": "node --test \"tests/regression/**/*.test.js\"",
    "test:golden:gate": "node scripts/golden.mjs gate",
    "test:security": "node --test \"tests/{build,security}/**/*.test.js\"",
    "test:desktop": "node --test \"tests/desktop/**/*.test.js\"",
    "test:browser": "npm run build && playwright test",
    "test:perf": "npm run build && node --test --test-concurrency=1 \"tests/perf/**/*.test.js\" && playwright test -c playwright.perf.config.mjs",
    "test:all": "npm test && npm run test:browser",
    "golden:check": "node scripts/golden.mjs check",
    "golden:prove": "node scripts/golden.mjs prove",
    "scan": "node scripts/privacy-scan.mjs --tracked",
    "scan:history": "node scripts/privacy-scan.mjs --tracked --history --require-denylist",
    "scan:release": "node scripts/privacy-scan.mjs --tracked --history --require-denylist --strict",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run scan && npm run lint && npm run format:check && npm run build && npm run verify:build && npm test"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "0.1.100",
    "@playwright/test": "1.62.1",
    "acorn": "8.18.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9"
  }
}
